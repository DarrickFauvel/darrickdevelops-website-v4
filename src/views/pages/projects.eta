<% layout('../layouts/base') %>

<section>
  <div class="container">
    <h1 class="section-title">Projects</h1>
    <p class="section-subtitle">Full-stack web applications built from scratch.</p>

    <% if (it.projects.length === 0) { %>
    <p style="margin-top: var(--space-8); color: var(--color-text-secondary)">Projects coming soon.</p>
    <% } else { %>
    <div class="grid-auto" style="margin-top: var(--space-8)"
         data-signals="{filterTag: 'all'}">

      <!-- Filter controls -->
      <div id="filter-controls" style="grid-column: 1 / -1" class="cluster">
        <button class="btn btn--sm btn--primary" data-on-click="$filterTag = 'all'">All</button>
        <% it.allTags.forEach(tag => { %>
        <button class="btn btn--sm btn--ghost" data-on-click="$filterTag = '<%= tag %>'"><%= tag %></button>
        <% }) %>
      </div>

      <% it.projects.forEach(p => { %>
      <project-card data-show="$filterTag === 'all' || '<%= p.tech_stack.join(',') %>'.split(',').includes($filterTag)">
        <% if (p.thumbnail_url) { %>
        <% if (p.thumbnail_frame) { %>
        <div class="card__image-frame" data-frame="<%= p.thumbnail_frame %>"><img src="<%= p.thumbnail_url %>" alt="<%= p.title %>" class="card__image"></div>
        <% } else { %>
        <img src="<%= p.thumbnail_url %>" alt="<%= p.title %>" class="card__image">
        <% } %>
        <% } else { %>
        <div class="card__image-placeholder" aria-hidden="true"></div>
        <% } %>
        <div class="card__body">
          <a href="/projects/<%= p.slug %>" class="card__title"><%= p.title %></a>
          <p class="card__summary"><%= p.summary %></p>
          <div class="cluster">
            <% p.tech_stack.forEach(t => { %><tech-badge><%= t %></tech-badge><% }) %>
          </div>
        </div>
        <div class="card__footer">
          <span class="card__status"><%= p.status %></span>
          <div class="cluster">
            <% if (p.live_url) { %><a href="<%= p.live_url %>" class="btn btn--sm btn--primary" target="_blank" rel="noopener">Live</a><% } %>
            <% if (p.repo_url) { %><a href="<%= p.repo_url %>" class="btn btn--sm btn--ghost" target="_blank" rel="noopener">Code</a><% } %>
          </div>
        </div>
      </project-card>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
