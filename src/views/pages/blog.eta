<% layout('../layouts/base') %>

<section>
  <div class="container">
    <h1 class="section-title">Blog</h1>
    <p class="section-subtitle">Writing about web development, tools, and craft.</p>

    <% if (it.posts.length === 0) { %>
    <p style="margin-top: var(--space-8); color: var(--color-text-secondary)">No posts yet — check back soon.</p>
    <% } else { %>
    <ul class="stack" style="margin-top: var(--space-8)" role="list">
      <% it.posts.forEach(post => { %>
      <li class="blog-entry">
        <a href="/blog/<%= post.slug %>" class="blog-entry__title"><%= post.title %></a>
        <% if (post.excerpt) { %><p class="blog-entry__excerpt"><%= post.excerpt %></p><% } %>
        <% if (post.published_at) { %>
        <time class="blog-entry__date" datetime="<%= post.published_at %>">
          <%= new Date(post.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
        </time>
        <% } %>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>
</section>

<style>
  .blog-entry { padding-block: var(--space-6); border-bottom: 1px solid var(--color-border); }
  .blog-entry__title { font-size: var(--text-xl); font-weight: 600; text-decoration: none; color: var(--color-text-primary); }
  .blog-entry__title:hover { color: var(--color-accent); }
  .blog-entry__excerpt { margin-top: var(--space-2); }
  .blog-entry__date { display: block; margin-top: var(--space-2); font-size: var(--text-sm); color: var(--color-text-secondary); }
</style>
