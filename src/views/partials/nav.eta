<div class="qr-modal" id="qr-modal" hidden tabindex="-1" role="dialog" aria-modal="true" aria-label="QR code">
  <div class="qr-modal__box">
    <button class="qr-modal__close" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <img class="qr-modal__img" src="" alt="QR code for this site" width="200" height="200">
    <p class="qr-modal__url"></p>
  </div>
</div>
